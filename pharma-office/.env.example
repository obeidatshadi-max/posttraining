# PostgreSQL connection (any Postgres 14+; Supabase Postgres also works)
DATABASE_URL=postgres://pharma:pharma@localhost:5432/pharma_office

# Secret used to sign session cookies. Generate with: openssl rand -base64 48
SESSION_SECRET=replace-with-a-long-random-secret-at-least-32-chars

# When "true", the login page lists the demo accounts. Never enable in production.
DEMO_MODE=true
